# ============================================================
# MySQL 配置：统一使用 utf8mb4
# 说明：MySQL 客户端默认字符集是 latin1，如果初始化 SQL（schema/data.sql）
#       用默认客户端导入，中文会被按 latin1 解释，导致数据库里出现
#       「å‰ç«¯å¼€å‘」这种双重编码乱码。
#       这里把 [client] / [mysql] 也设为 utf8mb4，保证初始化导入正确。
# ============================================================
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
