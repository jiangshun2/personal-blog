# ============================================================
# 生产环境变量模板
# 用法：复制本文件为 .env，填入真实强密码
# 注意：.env 已被 .gitignore 忽略，不会提交到 Git
# ============================================================

# MySQL root 密码（务必改成强密码）
MYSQL_ROOT_PASSWORD=change_me_mysql_password

# Redis 密码
REDIS_PASSWORD=change_me_redis_password

# JWT 签名密钥（至少 32 位随机字符串；可用 openssl rand -base64 32 生成）
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
